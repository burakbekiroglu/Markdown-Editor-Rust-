{
  "name": "md-editor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Hafif Windows Markdown editoru (Tauri v2 + Svelte 5 + CodeMirror 6)",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "perf:bundle": "node scripts/check-bundle-budget.mjs",
    "perf:measure": "node scripts/measure-perf.mjs",
    "perf:startup": "node scripts/measure-perf.mjs --startup --gate-startup",
    "perf:regression": "node scripts/measure-perf.mjs --startup --gate-startup --json-out .temp_files/startup-current.json --compare-baseline",
    "perf:memory": "node scripts/measure-perf.mjs --tabs 5 --runs 1 --visit-tabs --max-rss-mib 150",
    "perf:installer": "node scripts/check-installer-budget.mjs",
    "budget:measure": "node scripts/measure-budgets.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-store": "^2.5.1",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.18",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.5",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "^24.10.1",
    "jsdom": "^31.0.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
